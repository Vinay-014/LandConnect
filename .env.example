# GEMINI_API_KEY: Required for Gemini Search & Maps Grounding API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive maps.
# Restrict key to HTTP referrers and Maps JavaScript API in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Optional overrides (auto-managed at runtime if omitted; uncomment only for multi-replica or TURN setups):
# PORT=3000
# NODE_ENV=production
# SQLITE_DB_PATH=".data/landconnect.sqlite"
# ENABLE_DEMO_AUTH="false"
# METRICS_TOKEN=""
# STORAGE_PUBLIC_BASE_URL=""
# GROUNDING_CACHE_TTL_HOURS=12
# JWT_SECRET=""
# CALL_TOKEN_SECRET=""
# TURN_SERVER_URL=""
# TURN_USERNAME=""
# TURN_CREDENTIAL=""
