{
  "expo": {
    "name": "LandConnect",
    "slug": "landconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow LandConnect to access your microphone for privacy-masked audio calls."
        }
      ]
    ]
  }
}
